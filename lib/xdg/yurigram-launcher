#!/bin/sh

bin=/usr/bin/yurigram
launcher_uid=$(id -u)

same_user_process() {
	while read -r key value rest; do
		[ "$key" = Uid: ] || continue
		[ "$value" = "$launcher_uid" ]
		return
	done < "$1/status" 2>/dev/null
	return 1
}

path_is_old_data() {
	case "$1" in
		"$old"|"$old"/*) return 0 ;;
	esac
	return 1
}

is_legacy_executable() {
	case "$1" in
		*/yukigram|*/Yukigram|*/yukigram' (deleted)'|*/Yukigram' (deleted)') return 0 ;;
	esac
	return 1
}

legacy_process_running() {
	for process in /proc/[0-9]*; do
		[ -d "$process" ] || continue
		[ "$process" = "/proc/$$" ] && continue
		same_user_process "$process" || continue

		path=$(readlink "$process/cwd" 2>/dev/null || true)
		path_is_old_data "$path" && return 0

		path=$(readlink "$process/exe" 2>/dev/null || true)
		is_legacy_executable "$path" && return 0

		for fd in "$process"/fd/*; do
			[ -L "$fd" ] || continue
			path=$(readlink "$fd" 2>/dev/null || true)
			path_is_old_data "$path" && return 0
		done
	done
	return 1
}

defer() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a Yurigram 'Yurigram migration deferred' "$1" >/dev/null 2>&1 || :
	fi
	printf '%s\n' "$1" >&2
	exit 75
}

[ -x "$bin" ] || {
	printf '%s\n' "Yurigram launcher: missing executable: $bin" >&2
	exit 127
}

[ -n "${HOME:-}" ] || exec "$bin" "$@"

data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
case "$data_home" in
	/*) ;;
	*) data_home="$HOME/.local/share" ;;
esac

old="$data_home/Yukigram"
new="$data_home/Yurigram"

if [ -d "$old/tdata" ] && [ ! -e "$new" ]; then
	legacy_process_running && defer 'Yukigram is still running. Close it before starting Yurigram for the first time.'
	mv -T -- "$old" "$new" || defer 'Could not migrate Yukigram data. Yurigram was not started.'
fi

exec "$bin" "$@"
